# One Discord webhook URL per event kind. An event whose variable is unset or
# empty is not relayed, so leaving every line empty disables the relay
# entirely. Several channels can receive the same event: separate the URLs
# with commas.
#
# moderation.action mirrors every row of the moderation log, so a channel that
# receives it will also see the typed events (bans, ratings, ...) it overlaps
# with if they are routed there too.
DISCORD_WEBHOOK_USERS_REGISTERED=
DISCORD_WEBHOOK_USERS_RENAMED=
DISCORD_WEBHOOK_USERS_BANNED=
DISCORD_WEBHOOK_USERS_UNBANNED=
DISCORD_WEBHOOK_USERS_FLAGGED=
DISCORD_WEBHOOK_LEVELS_UPLOADED=
DISCORD_WEBHOOK_LEVELS_UPDATED=
DISCORD_WEBHOOK_LEVELS_DELETED=
DISCORD_WEBHOOK_LEVELS_RATED=
DISCORD_WEBHOOK_TIMELY_SCHEDULED=
DISCORD_WEBHOOK_ROLES_ASSIGNED=
DISCORD_WEBHOOK_ROLES_REVOKED=
DISCORD_WEBHOOK_SERVER_SETTINGS_UPDATED=
DISCORD_WEBHOOK_LEADERBOARDS_REBUILT=
DISCORD_WEBHOOK_MODERATION_ACTION=

# How long a webhook request may take.
DISCORD_TIMEOUT_SECONDS=10
